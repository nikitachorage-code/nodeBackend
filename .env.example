# Runtime environment: development | test | production
NODE_ENV=development
# HTTP port the API listens on
PORT=3000
# Comma-separated list of allowed CORS origins
CORS_ORIGIN=http://localhost:5173
# PostgreSQL connection string (docker-compose.yml provides this database)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/certtracker?schema=public
# Secret used to sign JWT access tokens (min 32 chars)
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-min-32-chars
# Access token lifetime (e.g. 15m, 1h, 7d)
JWT_ACCESS_TTL=1h
# Directory for uploaded files (random names, never served statically)
UPLOAD_DIR=./uploads
# Max upload size in bytes (default 5 MB)
MAX_UPLOAD_BYTES=5242880
# Enables POST /api/admin/clock. Ignored (forced off) when NODE_ENV=production
ALLOW_TIME_TRAVEL=false
# Return verification/reset tokens in API responses (for testing without an inbox)
EXPOSE_DEV_TOKENS=false
# Run the daily lapse job (set false for tests or extra instances)
ENABLE_SCHEDULER=true
# Requests per minute allowed on any route, per IP
GLOBAL_THROTTLE_LIMIT=100
# Requests per minute allowed on auth routes, per IP
AUTH_THROTTLE_LIMIT=10
# Days before Year 3 starts when the lapse warning email is sent
WARNING_LEAD_DAYS=30
# Seed script: admin account
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin123!
